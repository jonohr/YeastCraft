FROM node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS ui
WORKDIR /build/ui
COPY ui/package*.json ./
RUN npm ci --no-audit --no-fund
COPY ui/ ./
RUN npm run build

FROM rust:1.99-bookworm@sha256:e6f2cff35d0f309acf8433b4f05878ed77092602c5065cc81801177da0bb3a9c AS backend
WORKDIR /build
COPY rust/Cargo.toml rust/Cargo.lock ./
COPY rust/src ./src
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/build/target cargo build --release --locked -j2 && cp target/release/fermentrack-rs /build/fermentrack-rs

FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/* && useradd --uid 1000 --create-home fermentrack && mkdir -p /app/state /app/private-import && chown -R fermentrack:fermentrack /app
WORKDIR /app
COPY --from=backend /build/fermentrack-rs /usr/local/bin/fermentrack-rs
COPY --from=ui /build/ui/dist /app/ui/dist
COPY LICENSE NOTICE.md /usr/share/doc/fermentrack-rs/
COPY LICENSES/ /usr/share/doc/fermentrack-rs/licenses/
USER fermentrack
ENV SQLITE_TMPDIR=/app/state
EXPOSE 8315
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD ["fermentrack-rs", "healthcheck"]
ENTRYPOINT ["fermentrack-rs"]
CMD ["--listen","0.0.0.0:8315"]
