FROM --platform=$BUILDPLATFORM node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS ui
WORKDIR /build/ui
COPY ui/package*.json ./
RUN npm ci --no-audit --no-fund
COPY ui/ ./
RUN npm run build

FROM --platform=$BUILDPLATFORM rust:1.99-bookworm@sha256:e6f2cff35d0f309acf8433b4f05878ed77092602c5065cc81801177da0bb3a9c AS backend
WORKDIR /build
ARG TARGETARCH
ARG TARGETVARIANT
# Compile on the builder CPU; only runtime packaging needs target execution.
RUN case "$TARGETARCH/$TARGETVARIANT" in \
      amd64/) target=x86_64-unknown-linux-gnu; compiler=x86_64-linux-gnu-gcc; package=gcc-x86-64-linux-gnu; headers=libc6-dev-amd64-cross ;; \
      arm64/|arm64/v8) target=aarch64-unknown-linux-gnu; compiler=aarch64-linux-gnu-gcc; package=gcc-aarch64-linux-gnu; headers=libc6-dev-arm64-cross ;; \
      arm/v7) target=armv7-unknown-linux-gnueabihf; compiler=arm-linux-gnueabihf-gcc; package=gcc-arm-linux-gnueabihf; headers=libc6-dev-armhf-cross ;; \
      *) echo "Unsupported target: $TARGETARCH/$TARGETVARIANT" >&2; exit 1 ;; \
    esac && \
    apt-get update && apt-get install -y --no-install-recommends "$package" "$headers" && rm -rf /var/lib/apt/lists/* && \
    rustup target add "$target" && \
    mkdir -p .cargo && printf '[target.%s]\nlinker = "%s"\n' "$target" "$compiler" > .cargo/config.toml && \
    printf '%s' "$target" > /build/rust-target
ENV CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CC_armv7_unknown_linux_gnueabihf=arm-linux-gnueabihf-gcc \
    CC_x86_64_unknown_linux_gnu=x86_64-linux-gnu-gcc
COPY rust/Cargo.toml rust/Cargo.lock ./
COPY rust/src ./src
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,id=rs-target-${TARGETARCH}-${TARGETVARIANT},target=/build/target \
    target="$(cat /build/rust-target)" && cargo build --release --locked --target "$target" -j2 && \
    cp "target/$target/release/yeastcraft" /build/yeastcraft

FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc AS runtime-files
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=backend /build/yeastcraft /usr/local/bin/yeastcraft
# Retain package provenance so vulnerability scanners can identify copied libraries.
# The final image has no shell, package manager, compiler or Node runtime.
RUN set -eu; \
    mkdir -p /runtime/usr/local/bin /runtime/etc/ssl/certs /runtime/var/lib/dpkg /runtime/usr/share/doc /runtime/app/state /runtime/app/private-import; \
    ldd /usr/local/bin/yeastcraft > /tmp/runtime-libraries; \
    ! grep -q 'not found' /tmp/runtime-libraries; \
    for lib in $(awk '/=> \// {print $3} /^[[:space:]]*\// {print $1}' /tmp/runtime-libraries); do cp -L --parents "$lib" /runtime; done; \
    cp /usr/local/bin/yeastcraft /runtime/usr/local/bin/; \
    cp /etc/ssl/certs/ca-certificates.crt /runtime/etc/ssl/certs/; \
    cp -L /etc/os-release /etc/debian_version /runtime/etc/; \
    dpkg-query -s libc6 libgcc-s1 gcc-12-base ca-certificates > /runtime/var/lib/dpkg/status; \
    for package in libc6 libgcc-s1 gcc-12-base ca-certificates; do mkdir -p "/runtime/usr/share/doc/$package"; cp -L "/usr/share/doc/$package/copyright" "/runtime/usr/share/doc/$package/"; done; \
    printf 'yeastcraft:x:1000:1000:YeastCraft:/app:/nonexistent\n' > /runtime/etc/passwd; \
    printf 'yeastcraft:x:1000:\n' > /runtime/etc/group; \
    printf 'hosts: files dns\n' > /runtime/etc/nsswitch.conf; \
    chown -R 1000:1000 /runtime/app
COPY LICENSES/ /tmp/rs-licenses/
RUN mkdir -p /runtime/usr/share/doc/yeastcraft && \
    tar --sort=name --mtime=@0 --owner=0 --group=0 -czf /runtime/usr/share/doc/yeastcraft/licenses.tar.gz -C /tmp/rs-licenses .

FROM scratch
ARG VCS_REF=unknown
LABEL org.opencontainers.image.source="https://github.com/jonohr/fermentrack-rs" \
    org.opencontainers.image.revision=$VCS_REF \
    org.opencontainers.image.licenses="GPL-3.0-only"
COPY --from=runtime-files /runtime/ /
WORKDIR /app
COPY --from=ui /build/ui/dist /app/ui/dist
COPY LICENSE NOTICE.md /usr/share/doc/yeastcraft/
USER 1000:1000
ENV SQLITE_TMPDIR=/app/state
# Release large temporary password-hashing buffers instead of retaining them in glibc arenas.
ENV MALLOC_MMAP_THRESHOLD_=131072
EXPOSE 8315
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD ["/usr/local/bin/yeastcraft", "healthcheck"]
ENTRYPOINT ["/usr/local/bin/yeastcraft"]
CMD ["--listen","0.0.0.0:8315"]
